# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==================== EMAIL CONFIGURATION (EmailJS - Free) ====================
# Sign up at https://www.emailjs.com/ (200 emails/month free)
# No backend server needed - works entirely client-side!
#
# Setup Steps:
# 1. Create free account at emailjs.com
# 2. Add your email service (Gmail/Outlook/Yahoo/etc)
# 3. Create an email template
# 4. Get your Public Key, Service ID, and Template ID
# 5. Configure in the Settings page of the application
#
# Template variables to use in EmailJS template:
# {{to_email}}, {{to_name}}, {{from_name}}, {{subject}}, {{message}}
