# ============================================================
# SAMS WhatsApp Gateway — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Comma-separated allowed CORS origins (no trailing slashes)
# Example: http://localhost:3000,https://sams.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── API Authentication ───────────────────────────────────────
# Comma-separated API keys (≥32 chars each). Supports 2+ keys for rotation.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=changeme_generate_a_32_char_key_here_aaaa,changeme_generate_second_key_bbbb

# ── WhatsApp Cloud API ───────────────────────────────────────
# Mode: 'live' calls Meta Graph API; 'mock' simulates everything locally.
WHATSAPP_MODE=mock

# From Meta Developer Console → App → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAPZAdrBUzC0BSi1r2lwcQybaSW8jS0YiXtKAK2eDw6u26yNFHZCNKk9pIZBJgcwIMarzKXOD0TmUyzv2i4YAeWk30YYzp0GcubkZCrDYm0zhZB9KHF0Wdkuk1xyhAiBhLWj3b9XZApUHdOh7EudmNnQjcmAoveB5OVWtETQ3vq8BsKo78DLrThXiWXtsE2deBzwZDZD
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_APP_SECRET=your_app_secret_here

# Webhook verify token — you choose this, then enter it in Meta console
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Graph API version — check https://developers.facebook.com/docs/graph-api/changelog
WHATSAPP_API_VERSION=v21.0

# ── Phone Defaults ───────────────────────────────────────────
# ISO 3166-1 alpha-2 country code used when parsing numbers without country code
DEFAULT_COUNTRY_CODE=PK

# ── Database ─────────────────────────────────────────────────
# Absolute or relative path to the SQLite database file
DB_PATH=./data/sams_whatsapp.db

# ── Rate Limits & Caps ───────────────────────────────────────
# Maximum messages sent per calendar day across all recipients
DAILY_MESSAGE_CAP=500

# Maximum messages per recipient per hour
PER_RECIPIENT_HOURLY_CAP=5

# Days to retain message/event records before purging
RETENTION_DAYS=90

# ── Static Serving ───────────────────────────────────────────
# Set to true to serve the built frontend from ../dist
SERVE_STATIC=false

# ── Mock Mode (only used when WHATSAPP_MODE=mock) ────────────
# Float 0–1: fraction of mock messages that simulate failure
MOCK_FAILURE_RATE=0.05

# Trust proxy (set to '1' when behind a reverse proxy like nginx/Caddy)
TRUST_PROXY=0
